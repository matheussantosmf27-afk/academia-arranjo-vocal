# Copie para .env.local e preencha com os dados do projeto Supabase EXCLUSIVO da Academia de Arranjo Vocal.
# Não use credenciais de outros projetos. Nunca versione .env.local.

# Públicas (vão para o navegador; protegidas por RLS). Use a chave PUBLISHABLE (sb_publishable_…),
# NUNCA a secret/service-role (sb_secret_…): o app recusa chaves secretas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Testes de integração (Postgres local descartável), ex.: postgres://postgres@localhost:54329/postgres
AAV_TEST_DATABASE_URL=

# Tutor de IA — somente servidor (serviço pago da Anthropic; sem ela o tutor aparece indisponível).
ANTHROPIC_API_KEY=
